1. Show customer names with ordered items
select first_name||' '||last_name as full_name,item
from customers a
join orders i 
on a.customer_id=i.order_id

2. Show customer full name and amount spent
select first_name||' '||last_name as full_name,amount
from customers c
join orders o
on c.customer_id =o.order_id

3. Find customers who ordered Keyboard
select a.first_name||' '||last_name as full_name,i.item
from customers a
join orders i 
on a.customer_id=i.order_id
where item='Keyboard'

4. Find customers with no orders
SELECT first_name 
FROM CUSTOMERS c
LEFT JOIN ORDERS o
ON c.customer_id=o.customer_id
WHERE o.order_id IS NULL

5. Total spent by each customer
select customer_id,sum(amount) as total
from orders 
group by (customer_id)

6. Count orders per customer
select customer_id,count(*) as total
from orders
group by(customer_id)

7. Find countries with more than 1 customer
select country,count(*) as total 
from customers
group by(country)
having total >1

8. Find customer who spent highest amount
select first_name||' '||last_name as full_name,c.customer_id,amount
from customers c
join orders o
on c.customer_id=o.order_id
where amount=(
  select max(amount) from orders
)

9. Rank customers by spending (Window Function)
select first_name || ' '||last_name as Full_Name, sum(amount) as Total,
rank() over(order by sum(amount) desc)as Rank
from customers c
join orders o
on c.customer_id=o.customer_id
group by c.customer_id

10. Find second highest order amount
select amount 
from orders
order by amount desc
limit 1 offset 1

11. Find customers whose age is above average
select * from customers
where age > (
	select avg(age) from customers
)

12. Find customers who placed orders
select customer_id
from orders
where customer_id in(
  select customer_id from orders
)

13. Find customers whose order amount is above their average
SELECT *
FROM Orders o1
WHERE amount >
(
    SELECT AVG(amount)
    FROM Orders o2
    WHERE o1.customer_id = o2.customer_id
);
